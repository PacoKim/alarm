{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alarm",
  "compatibility_date": "2026-09-11",

  // Cloudflare Pages 배포.
  // public/ 을 그대로 올리고, 그 안의 _worker.js 가 모든 요청을 처리한다.
  // 정적 파일은 코드에서 env.ASSETS 로 꺼낸다 (Pages가 자동으로 제공).
  //
  // _worker.js 는 `npm run build` 로 src/ 에서 생성한다.
  // 저장소에 함께 커밋해 두므로 Pages 쪽 빌드 명령 설정이 필요하지 않다.
  "pages_build_output_dir": "public",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-reminder",
      "database_id": "2ac8f4b3-f036-43cc-bcea-99b9396758a1"
    }
  ]
}
