{
  "name": "family-reminder",
  "version": "1.0.0",
  "description": "가족 일정·메모를 모아 아이폰 잠금화면 위젯으로 보여주는 앱 (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev --port 8788",
    "deploy": "wrangler deploy",
    "setup": "sh scripts/setup-cloudflare.sh",
    "db:local": "wrangler d1 migrations apply family-reminder --local",
    "db:remote": "wrangler d1 migrations apply family-reminder --remote",
    "db:shell": "wrangler d1 execute family-reminder --remote --command",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "logs": "wrangler tail"
  },
  "type": "module",
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  },
  "private": true
}
