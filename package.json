{
  "name": "family-reminder",
  "version": "1.0.0",
  "description": "가족 일정·메모를 모아 아이폰 잠금화면 위젯으로 보여주는 앱 (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "npm run build && wrangler pages dev --port 8788",
    "deploy": "npm run build && wrangler pages deploy",
    "db:local": "wrangler d1 migrations apply family-reminder --local",
    "db:remote": "wrangler d1 migrations apply family-reminder --remote",
    "db:shell": "wrangler d1 execute family-reminder --remote --command",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "logs": "wrangler pages deployment tail --project-name alarm",
    "build": "node scripts/build-worker.mjs",
    "deploy:notifier": "wrangler deploy -c wrangler.notifier.jsonc",
    "logs:notifier": "wrangler tail -c wrangler.notifier.jsonc",
    "test": "node scripts/test-nlp.mjs"
  },
  "type": "module",
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.1"
  },
  "private": true
}
