{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alarm",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-11",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 모든 요청을 Worker가 먼저 받는다. 그래야 정적 파일 응답에도
    // 보안 헤더(CSP 등)를 붙일 수 있고 /api/* 가 가로채이지 않는다.
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "family-reminder",
      "database_id": "2ac8f4b3-f036-43cc-bcea-99b9396758a1"
    }
  ]
}
